      </column>
      <column caption='TextEnglandPopulation' datatype='string' name='[Calculation_1205931670056975]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Office for National Statistics - England population 2024&quot;' />
      </column>
      <column caption='Financial Year' datatype='string' name='[Calculation_1222966693089281]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='RatewithoEfW' datatype='real' name='[Calculation_1282904171061248]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[total_tonnes]&#13;&#10;/&#13;&#10;[Calculation_1282904171671553]' />
      </column>
      <column caption='TotalEnergy' datatype='real' name='[Calculation_1282904171671553]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_1222966693089281],[treatment_group],[waste_stream_type],[geography_type]:&#13;&#10;SUM(IF [facility_type] = &quot;Incineration with energy recovery&quot; OR &#13;&#10;[facility_type] = &quot;Incineration without energy recovery&quot; OR &#13;&#10;[facility_type] = &quot;Advanced thermal treatment&quot; THEN    &#13;&#10;[total_tonnes]&#13;&#10;END)&#13;&#10;}' />
      </column>
      <column caption='LandfillButtonSize' datatype='integer' name='[Calculation_1356023117049856]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(1)' />
      </column>
      <column caption='IncinerationButtonSize' datatype='integer' name='[Calculation_1356023117127681]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(1)' />
      </column>
      <column caption='SelectButtIncineration' datatype='boolean' name='[Calculation_1612208523689987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [treatment_group] = &apos;Incineration&apos; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='ButtFacilityFilter' datatype='string' name='[Calculation_1612208528330763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [treatment_group] = &apos;Incineration&apos; THEN &apos;Incineration&apos;&#13;&#10;ELSEIF [treatment_group] = &apos;Landfill&apos; THEN &apos;Landfill&apos;&#13;&#10;ELSE &apos;Incineration&apos;&#13;&#10;END' />
      </column>
      <column caption='ButtonIncineration' datatype='string' name='[Calculation_1612208529985550]' role='dimension' type='nominal'>
