          <annotation class='point' id='1' mark-position='1' pullback='0' text-width='88'>
            <formatted-text>
              <run bold='true'>Æ </run>
            </formatted-text>
            <point>
              <visual-coordinate class='axis'>
                <x-coord axis-value='174285.60823427988'>
                  <node-reference>
                    <axis>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[usr:Calculation_0404119769726976:qk:1]</axis>
