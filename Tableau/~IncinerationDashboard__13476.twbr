            <formatted-text>
              <run fontalignment='0' fontsize='11'>Based on 2015/16, you will find each year difference in incineration with/without EfW. </run>
            </formatted-text>
            <point>
              <visual-coordinate class='mark'>
                <tuple-reference>
                  <tuple-descriptor>
                    <pane-descriptor>
                      <x-fields>
                        <field>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[usr:Calculation_0404119769726976:qk:1]</field>
