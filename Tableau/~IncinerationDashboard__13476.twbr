      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[sum:Total Tonnes Recycling (copy)_1367277910958083:qk]&quot;' value='Total Incineration' />
          <alias key='&quot;[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[sum:Total Tonnes Recycling (copy)_1367277911437316:qk]&quot;' value='Total Landfill' />
        </aliases>
      </column>
      <column caption='TotalIncinerationTonnesAuthority15' datatype='real' name='[ALLTotalLandfillTonnesAuthority2015-2025 (copy) (copy)_0958825910222857]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [geography_type]:&#13;&#10;    SUM(IF ([treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos;) THEN&#13;&#10;            [total_tonnes]&#13;&#10;        END)&#13;&#10;&#13;&#10;}' />
      </column>
      <column caption='Bng E' datatype='integer' name='[BNG_E]' role='measure' type='quantitative' />
      <column caption='Bng N' datatype='integer' name='[BNG_N]' role='measure' type='quantitative' />
      <column caption='KgIncinerationPopulation' datatype='real' name='[Calculation_0185859066048512]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0929403308261376] * 1000' />
      </column>
      <column caption='kgLandfillPopulation' datatype='real' name='[Calculation_0185859066605569]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[IncinerationPopulation (copy)_0929403348529156] * 1000' />
      </column>
      <column caption='FacilitiesDifference' datatype='integer' name='[Calculation_0200983689203712]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(ATTR([Calculation_0678433199697920]), -1))&#13;&#10;   OR ATTR([Calculation_0678433199697920]) &lt;&gt; LOOKUP(ATTR([Calculation_0678433199697920]), -1)&#13;&#10;THEN&#13;&#10;    COUNTD([national_facility_id])&#13;&#10;ELSE&#13;&#10;    COUNTD([national_facility_id])&#13;&#10;    - LOOKUP(COUNTD([national_facility_id]), -1)&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='FaciltiesDiffLabel' datatype='string' name='[Calculation_0200983728013327]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF ISNULL(LOOKUP(ATTR([Calculation_0678433199697920]), -1))&#13;&#10;   OR ATTR([Calculation_0678433199697920]) &lt;&gt; LOOKUP(ATTR([Calculation_0678433199697920]), -1)&#13;&#10;THEN STR([Calculation_0200983689203712]) + &quot; facilities&quot;&#13;&#10;ELSE STR([Calculation_0200983689203712]) + &quot; difference&quot;&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='ArticleSingapore' datatype='string' name='[Calculation_0357934649405441]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; More info: How Singapore achieved sustainable incineration&quot;' />
      </column>
      <column caption='DifferenceProcessed' datatype='real' name='[Calculation_0404119769726976]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF FIRST() = 0 THEN&#13;&#10;    SUM([total_tonnes])&#13;&#10;ELSE&#13;&#10;    SUM([total_tonnes]) - LOOKUP(SUM([total_tonnes]), FIRST())&#13;&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='RateDiffPercentage' datatype='real' name='[Calculation_0404119778316289]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Calculation_1282904171061248]) - LOOKUP(SUM([Calculation_1282904171061248]), -1)'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='LinkIncinerationEnergy' datatype='string' name='[Calculation_0541008619732998]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;    Article about North London energy recovery plan in Haringey&quot;' />
      </column>
      <column caption='Treatment Groups' datatype='string' name='[Calculation_0678433199697920]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [facility_type] = &quot;Inert landfill&quot;&#13;&#10;OR [facility_type] = &quot;Non-hazardous landfill&quot;&#13;&#10;OR [facility_type] = &quot;Hazardous landfill&quot;&#13;&#10;THEN &quot;Landfill&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Incineration with energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Incineration without energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Advanced Thermal Treatment&quot; &#13;&#10;THEN &quot;Incineration&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Reprocessor - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Exporter - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Reuse (qu35)&quot;&#13;&#10;OR [facility_type] = &quot;In vessel composting&quot;&#13;&#10;OR [facility_type] = &quot;Windrow or other composting&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Segregated&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Whole Waste&quot;&#13;&#10;THEN &quot;Recycling&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other treatment&quot;&#13;&#10;END' />
      </column>
      <column caption='LinkArticleAboutEnglandTowardsIncineartion' datatype='string' name='[Calculation_0710599579664413]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;  More info: Plan to increase waste burning&quot;' />
      </column>
      <column caption='LinkOurOutcome' datatype='string' name='[Calculation_0710599584428064]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot; More info: London&apos;s recycling rate stagnant&quot;' />
      </column>
      <column caption='LinkUKincineration' datatype='string' name='[Calculation_0710599589974049]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;    The UK dirtiest form of power&quot;' />
      </column>
      <column caption='TotalTonnesDistrict' datatype='real' name='[Calculation_0772182839238659]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [treatment_group],[Region],[geography_type],[Calculation_1222966693089281],[waste_stream_type]:&#13;&#10;    SUM(IF ([treatment_group] = &apos;Incineration&apos; OR [treatment_group] = &apos;Landfill&apos;) THEN&#13;&#10;        [total_tonnes]&#13;&#10;    END)&#13;&#10;}' />
      </column>
      <column caption='IncinerationTonnesHabitant' datatype='real' name='[Calculation_0929403308261376]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([TotalTonnesYearDistrict (copy)_0404119881465859])/MAX([population])' />
      </column>
      <column caption='TotalLondon15' datatype='real' name='[Calculation_0958825910693898]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{FIXED [geography_type]:&#13;&#10;        SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)&#13;&#10;}' />
      </column>
      <column caption='DiffIncinerationAuthority25-15' datatype='real' name='[Calculation_0958825910902795]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[TotalLandfillTonnesAuthority2015-2025 (copy)_0958825903882248] - [ALLTotalLandfillTonnesAuthority2015-2025 (copy) (copy)_0958825910222857]' />
      </column>
      <column caption='RateIncinerationAuthority25-15' datatype='real' name='[Calculation_0958825911181324]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Calculation_0958825910902795]/[Calculation_0958825910693898]' />
      </column>
      <column caption='HighestIncinerationAuthority' datatype='string' name='[Calculation_0958825913405453]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{FIXED :MAX(&#13;&#10;IF { FIXED [authority] : &#13;&#10;    (&#13;&#10;        ZN(SUM(IF [treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos; THEN [total_tonnes] END))&#13;&#10;        -&#13;&#10;        ZN(SUM(IF [treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END))&#13;&#10;    )&#13;&#10;    /&#13;&#10;    NULLIF(ZN(SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)), 0)&#13;&#10;   }&#13;&#10;   = &#13;&#10;   { MAX(&#13;&#10;        { FIXED [authority] : &#13;&#10;            (&#13;&#10;                ZN(SUM(IF [treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos; THEN [total_tonnes] END))&#13;&#10;                -&#13;&#10;                ZN(SUM(IF [treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END))&#13;&#10;            )&#13;&#10;            /&#13;&#10;            NULLIF(ZN(SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)), 0)&#13;&#10;        }&#13;&#10;   ) }&#13;&#10;THEN [authority] &#13;&#10;END)&#13;&#10;}' />
      </column>
      <column caption='NumberFacilities' datatype='integer' name='[Calculation_0975577955205121]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([national_facility_id])' />
      </column>
      <column caption='TextEnglandRegions' datatype='string' name='[Calculation_1205931668656141]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Office for National Statistics - England authority districts 2025&quot;' />
      </column>
      <column caption='TextWasteDataFlow' datatype='string' name='[Calculation_1205931669483534]' role='dimension' type='nominal'>
