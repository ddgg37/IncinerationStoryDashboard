                <zone fixed-size='280' h='14235' id='66' is-fixed='true' name='LineResidualWasteTonnes' w='71742' x='0' y='29181'>
                  <layout-cache minheight='195' type-h='scalable' type-w='cell' />
                  <zone-style>
                    <format attr='border-color' value='#000000' />
