                <zone fixed-size='98' h='2847' id='43' is-fixed='true' name='KPILorry' show-title='false' w='33309' x='33382' y='26097'>
                  <layout-cache fixed-size-h='95' type-h='fixed' type-w='fixed' />
                  <zone-style>
