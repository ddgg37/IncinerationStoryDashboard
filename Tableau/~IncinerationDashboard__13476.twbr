              <formatted-text>
                <run fontcolor='#000000' fontsize='12' indent='11520'>Æ                                                                                                                                                                                                                                                        </run>
                <run indent='11160'>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'>Key concepts used in this dashboard:                                                                                                                                                                          </run>
                <run indent='11160'>Æ&#10;</run>
                <run fontsize='12' indent='11160'>Æ                                                                                                                                                                                                                                                         </run>
                <run indent='11160'>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'>    - </run>
                <run bold='true' fontcolor='#000000' fontsize='12' indent='11160'>Waste Facilities:</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'> sites where collected waste is received, sorted, processed, recycled, treated or disposed of.       </run>
                <run indent='11160'>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'>    - </run>
                <run bold='true' fontcolor='#000000' fontsize='12' indent='11160'>Waste Stream Type:</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'> describes the category of waste collected.</run>
                <run bold='true' fontcolor='#000000' fontsize='12' indent='11160'>Æ                                                                                                          </run>
                <run indent='11160'>Æ&#10;</run>
                <run bold='true' fontcolor='#000000' fontsize='12' indent='11160'>    - Residual Waste:</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'> general household waste that has not been separately collected for recycling or composting.       </run>
                <run indent='11160'>Æ&#10;</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'>    - </run>
                <run bold='true' fontcolor='#000000' fontsize='12' indent='11160'>Treatment Route:</run>
                <run fontcolor='#000000' fontsize='12' indent='11160'> describes how and where waste moves through the waste management system.             </run>
                <run fontcolor='#000000' indent='11160'>Æ                          </run>
              </formatted-text>
            </customized-tooltip>
            <style>
              <style-rule element='mark'>
                <format attr='shape' value='2ndProjectShapes/info(1).png' />
                <format attr='size' value='1.5932043790817261' />
                <format attr='mark-labels-cull' value='true' />
                <format attr='mark-labels-mode' value='all' />
                <format attr='mark-transparency' value='255' />
              </style-rule>
            </style>
