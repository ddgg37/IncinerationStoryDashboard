      <size maxheight='4215' maxwidth='1366' minheight='4215' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='385' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='99383' id='380' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
              <zone fixed-size='1200' h='99383' id='40' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
                <zone fixed-size='1100' friendly-name='Introduction' h='26097' id='3' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
                  <zone fixed-size='142' friendly-name='MainTitle' h='3369' id='5' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
                    <zone fixed-size='81' forceUpdate='true' h='3345' id='6' is-fixed='true' type-v2='text' w='100000' x='0' y='0'>
                      <formatted-text>
                        <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='20'>Residual Waste Treatment in London</run>
                        <run fontalignment='1'>Æ&#10;</run>
                        <run fontalignment='1' fontcolor='#000000' fontsize='15' italic='true'>Following a decade of change: where London&apos;s residual waste goes and how it is treated</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='30' />
                      </zone-style>
                    </zone>
                  </zone>
                  <zone fixed-size='271' friendly-name='IntroTextPicture' h='6429' id='9' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='3369'>
                    <zone fixed-size='333' h='6429' id='224' is-fixed='true' is-scaled='1' param='Image/EnergyRecovery 1.png' type-v2='bitmap' w='25842' x='0' y='3369'>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='10' />
                        <format attr='padding' value='20' />
                      </zone-style>
                    </zone>
                    <zone fixed-size='1017' forceUpdate='true' h='6429' id='11' is-fixed='true' type-v2='text' w='74158' x='25842' y='3369'>
                      <formatted-text>
                        <run fontcolor='#1b1b1b' fontsize='12'>    Every day, millions of tonnes of waste are thrown into bins across London. Once the collection vehicle disappears down the road, most of us give little thought to what happens next.</run>
                        <run>Æ&#10;&#10;</run>
                        <run fontcolor='#1b1b1b' fontsize='12'>    But throwing something away is only the beginning of its journey. Waste moves through a complex network of collection systems, sorting centres and treatment facilities. </run>
                        <run>Æ&#10;&#10;</run>
                        <run fontcolor='#1b1b1b' fontsize='12'>    London&apos;s </run>
                        <run bold='true' fontcolor='#1b1b1b' fontsize='12'>residual waste</run>
                        <run fontcolor='#1b1b1b' fontsize='12'> journey data comes with few surprises that are worth exploring; </run>
                        <run bold='true' fontcolor='#1b1b1b' fontsize='12'>how the waste we throw away is treated, where it goes and how the picture differs across different London boroughs</run>
                        <run fontcolor='#1b1b1b' fontsize='12'>.</run>
                        <run>Æ&#10;</run>
                      </formatted-text>
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
                        <format attr='border-width' value='0' />
                        <format attr='margin' value='4' />
                        <format attr='padding' value='10' />
                        <format attr='padding-right' value='40' />
                        <format attr='padding-left' value='20' />
                      </zone-style>
                    </zone>
                  </zone>
                  <zone fixed-size='744' friendly-name='CollectionRoute' h='16299' id='29' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='9798'>
