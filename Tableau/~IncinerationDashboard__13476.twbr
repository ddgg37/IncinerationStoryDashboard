                <zone fixed-size='600' friendly-name='IncinerationLandfill' h='14472' id='65' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='28944'>
                  <zone fixed-size='699' friendly-name='LineChart' h='14235' id='71' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='29181'>
                    <zone fixed-size='972' h='14235' id='66' is-fixed='true' name='LineResidualWasteTonnes' w='71742' x='0' y='29181'>
                      <layout-cache minheight='195' type-h='scalable' type-w='cell' />
                      <zone-style>
                        <format attr='border-color' value='#000000' />
                        <format attr='border-style' value='none' />
