                    </columns>
                  </tuple-descriptor>
                  <tuple>
                    <value>&quot;2015/16&quot;</value>
                    <value>&quot;Incineration with EfW&quot;</value>
                    <value>&quot;Incineration with energy recovery&quot;</value>
                    <value>0.99151394339425403</value>
