            <column caption='Financial Year' datatype='string' name='[Calculation_1222966693089281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='HighestLandfillAuthority' datatype='string' name='[HighestIncinerationAuthority (copy)_0958825920585742]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='{FIXED :MAX(&#13;&#10;IF { FIXED [authority] : &#13;&#10;    (&#13;&#10;        ZN(SUM(IF [treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos; THEN [total_tonnes] END))&#13;&#10;        -&#13;&#10;        ZN(SUM(IF [treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END))&#13;&#10;    )&#13;&#10;    /&#13;&#10;    NULLIF(ZN(SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)), 0)&#13;&#10;   }&#13;&#10;   = &#13;&#10;   { MAX(&#13;&#10;        { FIXED [authority] : &#13;&#10;            (&#13;&#10;                ZN(SUM(IF [treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos; THEN [total_tonnes] END))&#13;&#10;                -&#13;&#10;                ZN(SUM(IF [treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END))&#13;&#10;            )&#13;&#10;            /&#13;&#10;            NULLIF(ZN(SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)), 0)&#13;&#10;        }&#13;&#10;   ) }&#13;&#10;THEN [authority] &#13;&#10;END)&#13;&#10;}' />
            </column>
