    <worksheet name='LineResidualWasteTonnes'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#1b1b1b' fontsize='16'>A shift from landfill to incineration in London</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ExportFromDBWasteCollectionSummary.csv+ (Multiple Connections)' name='federated.1s9f3fk04vwlwq14q6lzw0c9zduq' />
          </datasources>
          <datasource-dependencies datasource='federated.1s9f3fk04vwlwq14q6lzw0c9zduq'>
            <column caption='Treatment Groups' datatype='string' name='[Calculation_0678433199697920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [facility_type] = &quot;Inert landfill&quot;&#13;&#10;OR [facility_type] = &quot;Non-hazardous landfill&quot;&#13;&#10;OR [facility_type] = &quot;Hazardous landfill&quot;&#13;&#10;THEN &quot;Landfill&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Incineration with energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Incineration without energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Advanced Thermal Treatment&quot; &#13;&#10;THEN &quot;Incineration&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Reprocessor - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Exporter - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Reuse (qu35)&quot;&#13;&#10;OR [facility_type] = &quot;In vessel composting&quot;&#13;&#10;OR [facility_type] = &quot;Windrow or other composting&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Segregated&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Whole Waste&quot;&#13;&#10;THEN &quot;Recycling&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other treatment&quot;&#13;&#10;END' />
            </column>
            <column caption='Financial Year' datatype='string' name='[Calculation_1222966693089281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='Facility Type' datatype='string' name='[facility_type]' role='dimension' type='nominal' />
            <column caption='Geography Type' datatype='string' name='[geography_type]' role='dimension' type='nominal' />
            <column-instance column='[Calculation_1222966693089281]' derivation='Min' name='[min:Calculation_1222966693089281:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0678433199697920]' derivation='None' name='[none:Calculation_0678433199697920:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_1222966693089281]' derivation='None' name='[none:Calculation_1222966693089281:nk]' pivot='key' type='nominal' />
            <column-instance column='[geography_type]' derivation='None' name='[none:geography_type:nk]' pivot='key' type='nominal' />
            <column-instance column='[treatment_group]' derivation='None' name='[none:treatment_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[waste_stream_type]' derivation='None' name='[none:waste_stream_type:nk]' pivot='key' type='nominal' />
            <column caption='Period Start' datatype='date' name='[period_start]' role='dimension' type='ordinal' />
            <column-instance column='[total_tonnes]' derivation='Sum' name='[sum:total_tonnes:qk]' pivot='key' type='quantitative' />
            <column caption='Total Tonnes' datatype='real' name='[total_tonnes]' role='measure' type='quantitative' />
            <column datatype='string' name='[treatment_group]' role='dimension' type='nominal' />
            <column caption='Waste Stream Type' datatype='string' name='[waste_stream_type]' role='dimension' type='nominal' />
          </datasource-dependencies>
          <computed-sort column='[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:Calculation_1222966693089281:nk]' direction='ASC' using='[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[min:Calculation_1222966693089281:nk]' />
          <filter class='categorical' column='[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:treatment_group:nk]'>
            <groupfilter function='union' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate'>
              <groupfilter function='member' level='[none:treatment_group:nk]' member='&quot;Incineration&quot;' />
              <groupfilter function='member' level='[none:treatment_group:nk]' member='&quot;Landfill&quot;' />
            </groupfilter>
          </filter>
          <filter class='categorical' column='[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:waste_stream_type:nk]'>
            <groupfilter function='member' level='[none:waste_stream_type:nk]' member='&quot;Residual waste&quot;' user:ui-domain='database' user:ui-enumeration='inclusive' user:ui-marker='enumerate' />
          </filter>
          <slices>
            <column>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:geography_type:nk]</column>
            <column>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:waste_stream_type:nk]</column>
