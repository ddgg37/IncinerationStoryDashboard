          <datasource-dependencies datasource='federated.1s9f3fk04vwlwq14q6lzw0c9zduq'>
            <column caption='KgIncinerationPopulation' datatype='real' name='[Calculation_0185859066048512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0929403308261376] * 1000' />
            </column>
            <column caption='kgLandfillPopulation' datatype='real' name='[Calculation_0185859066605569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[IncinerationPopulation (copy)_0929403348529156] * 1000' />
            </column>
            <column caption='IncinerationTonnesHabitant' datatype='real' name='[Calculation_0929403308261376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([TotalTonnesYearDistrict (copy)_0404119881465859])/MAX([population])' />
            </column>
            <column caption='Financial Year' datatype='string' name='[Calculation_1222966693089281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='LandfillTonnesHabitant' datatype='real' name='[IncinerationPopulation (copy)_0929403348529156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Tonnes Recycling (copy)_1367277911437316])/MAX([population])' />
            </column>
            <column caption='London Subregion' datatype='string' name='[London_Subregion]' role='dimension' type='nominal' />
            <column caption='TotalLandfillTonnesAuthority24/25' datatype='real' name='[Total Tonnes Recycling (copy)_1367277911437316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [treatment_group],[authority],[geography_type]:&#13;&#10;    SUM(IF ([treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos;) THEN&#13;&#10;        [total_tonnes]&#13;&#10;    END)&#13;&#10;}' />
            </column>
            <column caption='TotalLandfillTonnesAuthority2015-2025' datatype='real' name='[TotalIncinerationTonnesAuthority2015-2025 (copy)_0958825890537474]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;    {FIXED [authority]:&#13;&#10;        SUM(IF ([treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos;) THEN&#13;&#10;                [total_tonnes]&#13;&#10;            END)&#13;&#10;        -&#13;&#10;        SUM(IF ([treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos;) THEN&#13;&#10;                [total_tonnes]&#13;&#10;            END)&#13;&#10;        /&#13;&#10;        SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)&#13;&#10;    }&#13;&#10;)' />
            </column>
            <column caption='TotalIncinerationTonnesAuthority2015-2025' datatype='real' name='[TotalTonnesDistrict (copy)_0958825874800640]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='ZN(&#13;&#10;    {FIXED [authority]:&#13;&#10;        (SUM(IF ([treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos;) THEN&#13;&#10;                [total_tonnes]&#13;&#10;            END)&#13;&#10;        -&#13;&#10;        SUM(IF ([treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos;) THEN&#13;&#10;                [total_tonnes]&#13;&#10;            END))&#13;&#10;        /&#13;&#10;        SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)&#13;&#10;    }&#13;&#10;)' />
            </column>
            <column caption='TotalIncinerationTonnesAuthority24/25' datatype='real' name='[TotalTonnesYearDistrict (copy)_0404119881465859]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{FIXED [treatment_group],[authority],[geography_type]:&#13;&#10;    SUM(IF ([treatment_group] = &apos;Incineration&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos;) THEN&#13;&#10;        [total_tonnes]&#13;&#10;    END)&#13;&#10;}' />
