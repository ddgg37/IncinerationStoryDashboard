        <calculation class='tableau' formula='ZN(&#13;&#10;    {FIXED [authority]:&#13;&#10;        SUM(IF ([treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2024/25&apos;) THEN&#13;&#10;                [total_tonnes]&#13;&#10;            END)&#13;&#10;        -&#13;&#10;        SUM(IF ([treatment_group] = &apos;Landfill&apos; AND [Calculation_1222966693089281] = &apos;2015/16&apos;) THEN&#13;&#10;                [total_tonnes]&#13;&#10;            END)&#13;&#10;        /&#13;&#10;        SUM(IF [Calculation_1222966693089281] = &apos;2015/16&apos; THEN [total_tonnes] END)&#13;&#10;    }&#13;&#10;)' />
