                      </y-fields>
                    </pane-descriptor>
                    <columns>
                      <field>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:Calculation_1222966693089281:nk]</field>
                      <field>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:Calculation_1672404789977088:nk]</field>
                      <field>[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[none:facility_type:nk]</field>
