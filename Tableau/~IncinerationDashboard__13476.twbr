                      <bucket>&quot;Incineration with energy recovery&quot;</bucket>
                    </multibucket>
                  </node-reference>
                </y-coord>
                <page-reference />
              </visual-coordinate>
            </point>
            <body x='258' y='-54' />
          </annotation>
          <annotation class='point' id='5' mark-position='1' pullback='0' text-width='358'>
            <formatted-text>
              <run fontsize='11'>Incineration without EfW seems to have become a thing of the past, London consistently diverts its residual waste towards energy generation.</run>
            </formatted-text>
            <point>
              <visual-coordinate class='axis'>
                <x-coord axis-value='31411.941018969046'>
