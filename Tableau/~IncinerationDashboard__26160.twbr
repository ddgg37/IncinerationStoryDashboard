        <calculation class='tableau' formula='IF ISNULL(LOOKUP(ATTR([Calculation_0678433199697920]), -1))&#13;&#10;   OR ATTR([Calculation_0678433199697920]) &lt;&gt; LOOKUP(ATTR([Calculation_0678433199697920]), -1)&#13;&#10;THEN STR([Calculation_0200983689203712]) + &quot; facilities&quot;&#13;&#10;ELSE STR([Calculation_0200983689203712]) + &quot; difference&quot;&#13;&#10;END'>
