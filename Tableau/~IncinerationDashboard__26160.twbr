          <alias key='&quot;2021/22 Q4&quot;' value='21/22 Q4' />
          <alias key='&quot;2022/23 Q1&quot;' value='22/23 Q1' />
          <alias key='&quot;2022/23 Q2&quot;' value='22/23 Q2' />
          <alias key='&quot;2022/23 Q3&quot;' value='22/23 Q3' />
          <alias key='&quot;2022/23 Q4&quot;' value='22/23 Q4' />
          <alias key='&quot;2023/24 Q1&quot;' value='23/24 Q1' />
          <alias key='&quot;2023/24 Q2&quot;' value='23/24 Q2' />
          <alias key='&quot;2023/24 Q3&quot;' value='23/24 Q3' />
          <alias key='&quot;2023/24 Q4&quot;' value='23/24 Q4' />
