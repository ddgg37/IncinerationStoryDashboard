      <column caption='Total Tonnes Recycling' datatype='real' name='[Calculation_1367277905063937]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_0678433199697920] = &quot;Recycling&quot;&#13;&#10;THEN [total_tonnes]&#13;&#10;END' />
      </column>
      <column caption='WasteGroups' datatype='string' name='[Calculation_1377999595757568]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [waste_stream_type] = &quot;Food waste&quot; THEN &quot;Food Waste&quot;&#13;&#10;&#13;&#10;ELSEIF [waste_stream_type] = &quot;Comingled recyclate&quot; THEN &quot;Dry Recycling&quot;&#13;&#10;&#13;&#10;ELSEIF [waste_stream_type] = &quot;Green waste&quot;&#13;&#10;OR [waste_stream_type] = &quot;Mixed green and food waste&quot; THEN &quot;Green Waste&quot;&#13;&#10;&#13;&#10;ELSEIF [waste_stream_type] = &quot;Residual waste&quot; THEN &quot;Residual Waste&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='SelectedRateTooltip' datatype='string' name='[Calculation_1499221328736256]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR(ROUND([Rate2122 (copy)_0583602800058368] * 100, 2)) + &quot;%&quot;' />
      </column>
      <column caption='WasteGroupExplanation' datatype='string' name='[Calculation_1499221462761475]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1377999595757568] = &quot;Food Waste&quot; THEN &quot;Food waste is mainly collected separately from households, such as leftover food and kitchen scraps.&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1377999595757568] = &quot;Dry Recycling&quot; THEN &quot;Dry recycling is recyclable household material collected separately from general waste, typically including paper, cardboard, glass, plastics and metal cans.&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1377999595757568] = &quot;Green Waste&quot; THEN &quot;Green waste is biodegradable garden waste collected mainly from households and gardens, including grass cuttings, leaves, branches, and plants, for composting.&quot;&#13;&#10;&#13;&#10;ELSEIF [Calculation_1377999595757568] = &quot;Residual Waste&quot; THEN &quot;Residual waste is household waste left, collected through general waste bins or black bags and usually sent for incineration or landfill.&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='SelectButtIncineration' datatype='boolean' name='[Calculation_1612208523689987]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [treatment_group] = &apos;Incineration&apos; THEN TRUE&#13;&#10;ELSE FALSE&#13;&#10;END' />
      </column>
      <column caption='ButtFacilityFilter' datatype='string' name='[Calculation_1612208528330763]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [treatment_group] = &apos;Incineration&apos; THEN &apos;Incineration&apos;&#13;&#10;ELSEIF [treatment_group] = &apos;Landfill&apos; THEN &apos;Landfill&apos;&#13;&#10;ELSE &apos;Incineration&apos;&#13;&#10;END' />
      </column>
      <column caption='ButtonIncineration' datatype='string' name='[Calculation_1612208529985550]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Incineration&quot;' />
      </column>
      <column caption='ButtonLandfill' datatype='string' name='[Calculation_1612208533147663]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;Landfill&quot;' />
      </column>
      <column caption='ResidualWasteTypeGroups' datatype='string' name='[Calculation_1621542848561158]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [facility_type] = &quot;Incineration with energy recovery&quot;&#13;&#10;    OR [facility_type] = &quot;Incineration without energy recovery&quot;&#13;&#10;    OR [facility_type] = &quot;Advanced Thermal Treatment&quot;&#13;&#10;THEN &quot;Incineration&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Non-hazardous landfill&quot;&#13;&#10;    OR [facility_type] = &quot;Hazardous landfill&quot;&#13;&#10;    OR [facility_type] = &quot;Inert landfill&quot;&#13;&#10;THEN &quot;Landfill&quot;&#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='IncinerationAbbreviation' datatype='string' name='[Calculation_1672404789977088]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [facility_type] = &quot;Incineration with energy recovery&quot; THEN &quot;Incineration with EfW&quot; &#13;&#10;ELSEIF [facility_type] = &quot;Incineration without energy recovery&quot; THEN &quot;Incineration without EfW&quot; &#13;&#10;END' />
      </column>
      <column caption='MaterialGroupsInFacility' datatype='string' name='[Calculation_1784000950321152]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF MIN([material_group]) = MAX([material_group]) THEN&#13;&#10;    MIN([material_group])&#13;&#10;ELSE&#13;&#10;    &quot;Multiple materials&quot;&#13;&#10;END' />
      </column>
      <column caption='ValidTreatmentGroupMap' datatype='boolean' name='[Calculation_1784000969003009]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0678433199697920] = &quot;Recycling&quot; &#13;&#10;OR [Calculation_0678433199697920] = &quot;Incineration&quot; &#13;&#10;OR [Calculation_0678433199697920] = &quot;Landfill&quot; THEN True &#13;&#10;ELSE False&#13;&#10;END' />
      </column>
      <column caption='Financiall Year Quarter' datatype='string' name='[Calculation_1805157994139649]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END&#13;&#10;&#13;&#10;+ &quot; Q&quot; +&#13;&#10;&#13;&#10;STR(&#13;&#10;    IF MONTH([period_start]) &gt;= 4 AND MONTH([period_start]) &lt;= 6 THEN 1&#13;&#10;    ELSEIF MONTH([period_start]) &gt;= 7 AND MONTH([period_start]) &lt;= 9 THEN 2&#13;&#10;    ELSEIF MONTH([period_start]) &gt;= 10 AND MONTH([period_start]) &lt;= 12 THEN 3&#13;&#10;    ELSE 4&#13;&#10;    END&#13;&#10;)' />
        <aliases>
          <alias key='&quot;2020/21 Q1&quot;' value='20/21 Q1' />
          <alias key='&quot;2020/21 Q2&quot;' value='20/21 Q2' />
          <alias key='&quot;2020/21 Q3&quot;' value='20/21 Q3' />
          <alias key='&quot;2020/21 Q4&quot;' value='20/21 Q4' />
          <alias key='&quot;2021/22 Q1&quot;' value='21/22 Q1' />
