              <lod column='[Parameters].[ParamBigPictureInfoButton (copy)_1205931639066624]' />
              <lod column='[Parameters].[ParamBigPictureInfoButton (copy)_1205931639066624]' />
            </encodings>
            <customized-tooltip show-buttons='false'>
              <formatted-text>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'>Few concepts that are used in this dashboard: </run>
                <run>Æ&#10;&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'>    - </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='9'>Waste facilities</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'> are sites where collected waste is received, sorted, processed, recycled, treated or disposed of.</run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'>    - </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='9'>Waste Stream Type</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'> describes the type of waste is collected;</run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='9'> residual waste</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'> is general waste that has not been separately collected for recycling or composting. </run>
                <run>Æ&#10;</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'>    - </run>
                <run bold='true' fontcolor='#000000' fontname='Tableau Light' fontsize='9'>Treatment route</run>
                <run fontcolor='#000000' fontname='Tableau Light' fontsize='9'> is where/how the waste moves through waste management system</run>
              </formatted-text>
            </customized-tooltip>
            <style>
