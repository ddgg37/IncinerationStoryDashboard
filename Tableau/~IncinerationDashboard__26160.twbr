    <worksheet name='WorstRecycling'>
      <table>
        <view>
          <datasources>
            <datasource caption='ExportFromDBWasteCollectionSummary.csv+ (Multiple Connections)' name='federated.1s9f3fk04vwlwq14q6lzw0c9zduq' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='ParameterSelectedRegion' datatype='string' name='[Parameter 0929403435167755]' param-domain-type='list' role='measure' type='nominal' value='&quot;All&quot;'>
              <calculation class='tableau' formula='&quot;All&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1s9f3fk04vwlwq14q6lzw0c9zduq'>
            <column caption='Treatment Groups' datatype='string' name='[Calculation_0678433199697920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [facility_type] = &quot;Inert landfill&quot;&#13;&#10;OR [facility_type] = &quot;Non-hazardous landfill&quot;&#13;&#10;OR [facility_type] = &quot;Hazardous landfill&quot;&#13;&#10;THEN &quot;Landfill&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Incineration with energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Incineration without energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Advanced Thermal Treatment&quot; &#13;&#10;THEN &quot;Incineration&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Reprocessor - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Exporter - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Reuse (qu35)&quot;&#13;&#10;OR [facility_type] = &quot;In vessel composting&quot;&#13;&#10;OR [facility_type] = &quot;Windrow or other composting&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Segregated&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Whole Waste&quot;&#13;&#10;THEN &quot;Recycling&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other treatment&quot;&#13;&#10;END' />
            </column>
            <column caption='Total Tonnes Recycling' datatype='real' name='[Calculation_1367277905063937]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0678433199697920] = &quot;Recycling&quot;&#13;&#10;THEN [total_tonnes]&#13;&#10;END' />
            </column>
            <column caption='RecyclingTonnesHabitant' datatype='real' name='[LandfillPopulation (copy)_0929403376820233]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1367277905063937])&#13;&#10;/&#13;&#10;MAX([population])' />
            </column>
            <column caption='ShowHighRecyclingTitle' datatype='string' name='[ShowHighLandfillTitle (copy)_1824406609739784]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 0929403435167755] = &quot;All&quot; THEN&#13;&#10;    &quot;Highest recycling producer&quot;&#13;&#10;END' />
            </column>
            <column caption='Facility Name' datatype='string' name='[facility_name]' role='dimension' type='nominal' />
            <column caption='Facility Type' datatype='string' name='[facility_type]' role='dimension' type='nominal' />
