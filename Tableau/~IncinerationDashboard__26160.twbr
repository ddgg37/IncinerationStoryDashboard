    <worksheet name='LondonMap'>
      <table>
        <view>
          <datasources>
            <datasource caption='ExportFromDBWasteCollectionSummary.csv+ (Multiple Connections)' name='federated.1s9f3fk04vwlwq14q6lzw0c9zduq' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.1s9f3fk04vwlwq14q6lzw0c9zduq'>
            <column caption='KgIncinerationPopulation' datatype='real' name='[Calculation_0185859066048512]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_0929403308261376] * 1000' />
            </column>
            <column caption='kgLandfillPopulation' datatype='real' name='[Calculation_0185859066605569]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[IncinerationPopulation (copy)_0929403348529156] * 1000' />
            </column>
            <column caption='Treatment Groups' datatype='string' name='[Calculation_0678433199697920]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [facility_type] = &quot;Inert landfill&quot;&#13;&#10;OR [facility_type] = &quot;Non-hazardous landfill&quot;&#13;&#10;OR [facility_type] = &quot;Hazardous landfill&quot;&#13;&#10;THEN &quot;Landfill&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Incineration with energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Incineration without energy recovery&quot;&#13;&#10;OR [facility_type] = &quot;Advanced Thermal Treatment&quot; &#13;&#10;THEN &quot;Incineration&quot;&#13;&#10;&#13;&#10;ELSEIF [facility_type] = &quot;Reprocessor - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Exporter - recycling (qu19)&quot;&#13;&#10;OR [facility_type] = &quot;Reuse (qu35)&quot;&#13;&#10;OR [facility_type] = &quot;In vessel composting&quot;&#13;&#10;OR [facility_type] = &quot;Windrow or other composting&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Segregated&quot;&#13;&#10;OR [facility_type] = &quot;Anaerobic or Aerobic Digestion Whole Waste&quot;&#13;&#10;THEN &quot;Recycling&quot;&#13;&#10;&#13;&#10;ELSE &quot;Other treatment&quot;&#13;&#10;END' />
            </column>
            <column caption='IncinerationTonnesHabitant' datatype='real' name='[Calculation_0929403308261376]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Tonnes Recycling (copy)_1367277910958083])/MAX([population])' />
            </column>
            <column caption='Financial Year' datatype='string' name='[Calculation_1222966693089281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column datatype='spatial' name='[Geometry]' role='measure' type='nominal' />
            <column caption='LandfillTonnesHabitant' datatype='real' name='[IncinerationPopulation (copy)_0929403348529156]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Total Tonnes Recycling (copy)_1367277911437316])/MAX([population])' />
            </column>
            <column caption='Lad23Nm' datatype='string' name='[LAD23NM]' role='dimension' type='nominal' />
            <column caption='Total Tonnes Incineration' datatype='real' name='[Total Tonnes Recycling (copy)_1367277910958083]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0678433199697920] = &quot;Incineration&quot;&#13;&#10;THEN [total_tonnes]&#13;&#10;END' />
            </column>
            <column caption='Total Tonnes Landfill' datatype='real' name='[Total Tonnes Recycling (copy)_1367277911437316]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_0678433199697920] = &quot;Landfill&quot;&#13;&#10;THEN [total_tonnes]&#13;&#10;END' />
            </column>
            <column-instance column='[Calculation_1222966693089281]' derivation='Attribute' name='[attr:Calculation_1222966693089281:nk]' pivot='key' type='nominal' />
            <column-instance column='[LAD23NM]' derivation='Attribute' name='[attr:LAD23NM:nk]' pivot='key' type='nominal' />
