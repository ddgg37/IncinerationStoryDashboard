    <worksheet name='EnergyRecovery'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#2a5783'>Tracking incineration growth: Annual tonnes relative to 2015/16</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='ExportFromDBWasteCollectionSummary.csv+ (Multiple Connections)' name='federated.1s9f3fk04vwlwq14q6lzw0c9zduq' />
          </datasources>
          <datasource-dependencies datasource='federated.1s9f3fk04vwlwq14q6lzw0c9zduq'>
            <column caption='DifferenceProcessed' datatype='real' name='[Calculation_0404119769726976]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF FIRST() = 0 THEN&#13;&#10;    SUM([total_tonnes])&#13;&#10;ELSE&#13;&#10;    SUM([total_tonnes]) - LOOKUP(SUM([total_tonnes]), FIRST())&#13;&#10;END'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='RateDiffPercentage' datatype='real' name='[Calculation_0404119778316289]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([Calculation_1282904171061248]) - LOOKUP(SUM([Calculation_1282904171061248]), -1)'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Financial Year' datatype='string' name='[Calculation_1222966693089281]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF MONTH([period_start]) &gt;= 4 THEN&#13;&#10;&#13;&#10;    STR(YEAR([period_start])) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start]) + 1), 2)&#13;&#10;&#13;&#10;ELSE&#13;&#10;&#13;&#10;    STR(YEAR([period_start]) - 1) + &quot;/&quot; +&#13;&#10;    RIGHT(STR(YEAR([period_start])), 2)&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='RatewithoEfW' datatype='real' name='[Calculation_1282904171061248]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[total_tonnes]&#13;&#10;/&#13;&#10;[Calculation_1282904171671553]' />
            </column>
            <column caption='TotalEnergy' datatype='real' name='[Calculation_1282904171671553]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ FIXED [Calculation_1222966693089281],[treatment_group],[waste_stream_type],[geography_type]:&#13;&#10;SUM(IF [facility_type] = &quot;Incineration with energy recovery&quot; OR &#13;&#10;[facility_type] = &quot;Incineration without energy recovery&quot; OR &#13;&#10;[facility_type] = &quot;Advanced thermal treatment&quot; THEN    &#13;&#10;[total_tonnes]&#13;&#10;END)&#13;&#10;}' />
            </column>
            <column caption='IncinerationAbbreviation' datatype='string' name='[Calculation_1672404789977088]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [facility_type] = &quot;Incineration with energy recovery&quot; THEN &quot;Incineration with EfW&quot; &#13;&#10;ELSEIF [facility_type] = &quot;Incineration without energy recovery&quot; THEN &quot;Incineration without EfW&quot; &#13;&#10;END' />
            </column>
            <column caption='Facility Type' datatype='string' name='[facility_type]' role='dimension' type='nominal' />
            <column caption='Geography Type' datatype='string' name='[geography_type]' role='dimension' type='nominal' />
