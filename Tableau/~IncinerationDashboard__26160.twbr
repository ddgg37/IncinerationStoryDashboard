                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='140' h='3081' id='20' is-fixed='true' is-scaled='1' param='Image/EnergyRecovery.png' type-v2='bitmap' w='28258' x='66764' y='8484'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='160' h='3287' id='25' is-fixed='true' is-scaled='1' param='Image/FamilyHome.png' type-v2='bitmap' w='31991' x='0' y='11976'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='493' forceUpdate='true' h='3287' id='26' type-v2='text' w='36091' x='31991' y='11976'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#18527f' underline='true'>Waste Collected from households</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#18527f'>    Before waste can be recycled, treated or disposed of, first, it has to be collected. Across England, household waste enters the system through different collection streams, from residual waste and dry recycling to food and garden waste. What goes into each bin helps determine where it can go next.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='120' h='3287' id='27' is-fixed='true' is-scaled='1' param='Image/RightDownArrow.png' type-v2='bitmap' w='31918' x='68082' y='11976'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='708' forceUpdate='true' h='3287' id='31' type-v2='text' w='51684' x='0' y='15263'>
                  <formatted-text>
                    <run fontcolor='#18527f'>  Once the waste collected by the rubbish/recycling service Collection vehicles transport different waste streams to facilities where materials can be received, stored, sorted and prepared for further treatment.</run>
                    <run>Æ&#10;</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='120' h='3287' id='32' is-centered='0' is-fixed='true' is-scaled='1' param='Image/LeftDownArrow.png' type-v2='bitmap' w='11713' x='51684' y='15263'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
                <zone fixed-size='160' h='3287' id='30' is-fixed='true' is-scaled='1' param='Image/LorryStorage.png' type-v2='bitmap' w='36603' x='63397' y='15263'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='0' />
                  </zone-style>
                </zone>
              </zone>
              <zone-style>
                <format attr='border-color' value='#000000' />
                <format attr='border-style' value='none' />
                <format attr='border-width' value='0' />
                <format attr='margin' value='0' />
                <format attr='background-color' value='#eef1f3' />
              </zone-style>
            </zone>
          </zones>
        </devicelayout>
      </devicelayouts>
      <simple-id uuid='{3140FF1B-7449-4B44-BAF8-CD6C900615FE}' />
    </dashboard>
    <dashboard enable-sort-zone-taborder='true' name='MainDashboardIncineration'>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#ffffff' />
        </style-rule>
      </style>
      <size maxheight='4868' maxwidth='1366' minheight='4868' minwidth='1366' preset-index='0' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='100000' id='269' param='horz' type-v2='layout-flow' w='100000' x='0' y='0'>
            <zone h='100000' id='40' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
              <zone fixed-size='1180' friendly-name='Introduction' h='24240' id='3' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
                <zone fixed-size='142' friendly-name='MainTitle' h='2917' id='5' is-fixed='true' param='vert' type-v2='layout-flow' w='100000' x='0' y='0'>
                  <zone fixed-size='81' forceUpdate='true' h='2897' id='6' is-fixed='true' type-v2='text' w='100000' x='0' y='0'>
                    <formatted-text>
                      <run bold='true' fontalignment='1' fontcolor='#555555' fontsize='20'>Residual waste treatment in London</run>
                      <run fontalignment='1'>Æ&#10;</run>
                      <run fontalignment='1' fontcolor='#555555' fontsize='15' italic='true'>Following a decade of change where London&apos;s residual waste goes and how it is treated</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='30' />
                    </zone-style>
                  </zone>
                </zone>
                <zone fixed-size='271' friendly-name='IntroTextPicture' h='5567' id='9' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='2917'>
                  <zone fixed-size='333' h='5567' id='224' is-fixed='true' is-scaled='1' param='Image/EnergyRecovery 1.png' type-v2='bitmap' w='24964' x='0' y='2917'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='padding' value='10' />
                    </zone-style>
                  </zone>
                  <zone fixed-size='1017' forceUpdate='true' h='5567' id='11' is-fixed='true' type-v2='text' w='75036' x='24964' y='2917'>
                    <formatted-text>
                      <run fontcolor='#555555' fontsize='10'>    Every day, millions of items are thrown into bins across London. Once the collection vehicle disappears down the road, most of us give little thought to what happens next.</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#555555' fontsize='10'>    But throwing something away is only the beginning of its journey. Waste moves through a complex network of collection systems, sorting centres and treatment facilities. </run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#555555' fontsize='10'>    London&apos;s </run>
                      <run bold='true' fontcolor='#555555' fontsize='10'>residual waste</run>
                      <run fontcolor='#555555' fontsize='10'> journey data comes with few surprises that worth exploring; </run>
                      <run bold='true' fontcolor='#555555' fontsize='10'>how the waste we throw is treated, where it goes and how the picture differs across different London boroughs</run>
                      <run fontcolor='#555555' fontsize='10'>.</run>
                      <run>Æ&#10;&#10;</run>
                      <run fontcolor='#555555' fontsize='10'>    Let&apos;s start first with an illustration about what is the waste journey.</run>
                    </formatted-text>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='4' />
                      <format attr='padding' value='10' />
                      <format attr='padding-right' value='40' />
                      <format attr='padding-left' value='20' />
                    </zone-style>
                  </zone>
                </zone>
                <zone fixed-size='12' h='411' id='28' is-fixed='true' type-v2='empty' w='100000' x='0' y='8484'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                  </zone-style>
                </zone>
                <zone fixed-size='744' friendly-name='CollectionRoute' h='15283' id='29' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='8895'>
                  <zone fixed-size='704' h='15283' id='32' is-fixed='true' is-scaled='1' param='Image/WasteTreatment.png' type-v2='bitmap' w='100000' x='0' y='8895'>
                    <zone-style>
                      <format attr='border-color' value='#000000' />
                      <format attr='border-style' value='none' />
                      <format attr='border-width' value='0' />
                      <format attr='margin' value='0' />
                      <format attr='margin-bottom' value='40' />
                    </zone-style>
                  </zone>
                </zone>
              </zone>
              <zone fixed-size='120' friendly-name='KPI' h='2465' id='41' is-fixed='true' param='horz' type-v2='layout-flow' w='100000' x='0' y='24240'>
                <zone fixed-size='437' h='2465' id='42' is-fixed='true' name='KPIpopulation' show-title='false' w='32577' x='0' y='24240'>
                  <layout-cache fixed-size-h='95' type-h='fixed' type-w='fixed' />
                  <zone-style>
                    <format attr='border-color' value='#18527f' />
