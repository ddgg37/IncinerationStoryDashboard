                <zone forceUpdate='true' h='1397' id='216' type-v2='text' w='13324' x='72621' y='37490'>
                  <formatted-text>
                    <run bold='true' fontalignment='1' fontcolor='#18527f' fontname='Tableau Bold' fontsize='10'>Landfill % drop</run>
                    <run fontalignment='1'>Æ&#10;</run>
                    <run bold='true' fontalignment='1' fontcolor='#18527f' fontname='Tableau Bold' fontsize='10'>these last 10 years</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
