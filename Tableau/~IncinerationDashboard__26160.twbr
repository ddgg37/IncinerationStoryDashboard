    <action caption='Filter1' name='[Action4_296C0B1F08C24642B9FBFFF3BB1445B7]'>
      <activation type='on-select' />
      <source dashboard='MainDashboardIncineration' type='sheet' worksheet='MapButtonFacility' />
      <link caption='Filter1' delimiter=',' escape='\' expression='tsl:MainDashboardIncineration?%5Bfederated.1s9f3fk04vwlwq14q6lzw0c9zduq%5D.%5Btreatment_group%5D~s0=&lt;[federated.1s9f3fk04vwlwq14q6lzw0c9zduq].[Calculation_1612208528330763]~na&gt;' include-null='true' multi-select='true' url-escape='true' />
      <command command='tsc:tsl-filter'>
        <param name='exclude' value='EnergyRecovery,ArticleEnergyCentre,ArticleUKdirty,InfoIconIntro,KPIfacilities,KPIpopulation,KPImaterial,LineResidualWasteTonnes,LondonMap,MapButtonFacility' />
        <param name='target' value='MainDashboardIncineration' />
      </command>
    </action>
