                  </zone-style>
                </zone>
                <zone fixed-size='280' h='15283' id='32' is-fixed='true' is-scaled='1' param='Image/WasteTreatment.png' type-v2='bitmap' w='100000' x='0' y='8895'>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
