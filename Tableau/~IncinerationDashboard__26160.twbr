                  </zone-style>
                </zone>
                <zone fixed-size='98' h='2465' id='42' is-fixed='true' name='KPIpopulation' show-title='false' w='32577' x='0' y='24240'>
                  <layout-cache fixed-size-h='95' type-h='fixed' type-w='fixed' />
                  <zone-style>
                    <format attr='border-color' value='#18527f' />
